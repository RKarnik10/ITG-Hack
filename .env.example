# Provider chain, tried in order (first available wins, failures fall through)
LLM_PROVIDERS=github,foundry,ollama,offline

# GitHub Models (free): fine-grained PAT with "Models: read" permission
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

# Azure AI Foundry / Azure OpenAI (optional, OpenAI v1-compatible endpoint)
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_MODEL=gpt-4.1-mini

# Local Ollama (free, offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
